# Copiar como .env.local y completar con firebaseConfig de la app WEB.
# Configuración pública del cliente; nunca usar claves administrativas aquí.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Mantener en 0 hasta autorizar y verificar Firestore/región/reglas desplegadas.
EXPO_PUBLIC_SAVED_LOCATIONS_ENABLED=0
# Mantener en 0 hasta publicar y verificar reglas de preferencias con autorización.
EXPO_PUBLIC_CARD_PREFERENCES_ENABLED=0
